HOST=0.0.0.0
PORT=3942
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Set true only when the browser connects through HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Local preview database is used only when SQL credentials are absent.
# Set false on the production server.
ALLOW_SQLITE_FALLBACK=false

# SQL Server authentication (SQL Login; Windows authentication is not used)
AUTH_DB_SERVER=192.168.120.38\odsm
AUTH_DB_NAME=bi
AUTH_DB_DRIVER=ODBC Driver 17 for SQL Server
AUTH_DB_USER=
AUTH_DB_PASSWORD=
AUTH_DB_ENCRYPT=no
AUTH_DB_TRUST_SERVER_CERTIFICATE=yes

# Purchase workflow database (can be a separate database/login)
DATA_DB_SERVER=192.168.120.38\odsm
DATA_DB_NAME=bi
DATA_DB_DRIVER=ODBC Driver 17 for SQL Server
DATA_DB_USER=
DATA_DB_PASSWORD=
DATA_DB_ENCRYPT=no
DATA_DB_TRUST_SERVER_CERTIFICATE=yes

PURCHASE_ADMIN_USERS=
