# Required application settings
FLASK_SECRET_KEY=replace-with-a-long-random-secret
PORT=3942

# Authentication: same organizational user table as productionplan_padra1
AUTH_DB_SERVER=192.168.120.38\odsm
AUTH_DB_NAME=bi
AUTH_DB_DRIVER=ODBC Driver 17 for SQL Server
AUTH_DB_USER=your_sql_username
AUTH_DB_PASSWORD=your_sql_password
AUTH_DB_ENCRYPT=no
AUTH_DB_TRUST_SERVER_CERTIFICATE=yes

# Purchase request database. Install sql/create_purchase_request_schema.sql first.
DATA_DB_SERVER=192.168.120.38\odsm
DATA_DB_NAME=bi
DATA_DB_DRIVER=ODBC Driver 17 for SQL Server
DATA_DB_USER=your_sql_username
DATA_DB_PASSWORD=your_sql_password
DATA_DB_ENCRYPT=no
DATA_DB_TRUST_SERVER_CERTIFICATE=yes

# Optional: set a comma-separated list of users allowed to configure approval routes.
PURCHASE_ADMIN_USERS=
